MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1456964035}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 745474e2018810c45b6ffe351c4b5d47, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OpeningManager
  cuts:
  - image: {fileID: -2014483067796448241, guid: 954750bd5f445ef4e9e5d4c9e9b0b49f, type: 3}
    lines:
    - "[]\uC5B4\uB450\uC6B4 \uBC29\uC548, TV\uC758 \uD654\uBA74\uB9CC\uC774 \uBC29
      \uC548\uC744 \uBC1D\uD78C\uB2E4."
    - "[\uB274\uC2A4] \uCD5C\uADFC \uC2E4\uC885 \uC0AC\uAC74\uB4E4\uC774 \uB2E4\uC218
      \uBC1C\uC0DD\uD558\uACE0 \uC788\uB2E4\uACE0 \uD569\uB2C8\uB2E4. \uD0C0\uC778\uC744
      \uC758\uC2EC\uD558\uACE0 \uACBD\uACC4\uD558\uBA70 \uAC01\uBCC4\uD788 \uC8FC\uC758\uD558\uC2DC\uAE30
      \uBC14\uB78D\uB2C8\uB2E4.\r "
    - "[] \uB274\uC2A4\uAC00 \uB05D\uB098\uACE0, \uAD11\uACE0\uAC00 \uC774\uC5B4\uC9C4\uB2E4.\r "
    - "[\uAD11\uACE0] \uB2F9\uC2E0\uC758 \uC77C\uC0C1\uC5D0 \uD568\uAED8\uD558\uB294
      AI, Hayat-401 "
    - "\uCD5C\uC2E0 \uBC84\uC804\uACFC \uD568\uAED8\uB77C\uBA74 \uB354\uC6B1 \uC5C5\uADF8\uB808\uC774\uB4DC\uB41C
      \uC790\uC2E0\uC744 \uB9CC\uB098\uBCF4\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    - "\uC5B4\uB5A4 \uC77C\uC774\uB4E0, \uC644\uBCBD\uD558\uAC8C!"
    - "[] \uCE74\uB9B0\uC740 TV \uC18C\uB9AC\uB97C \uD758\uB824\uB4E3\uB294\uB2E4.
      \uC2DC\uC120\uC740 \uBCBD\uC5D0 \uAC78\uB9B0 \uAC00\uC871 \uC0AC\uC9C4\uC5D0
      \uBA38\uBB38\uB2E4."
    - "[] \uC0DD\uAC01\uC5D0 \uC7A0\uAE30\uB824\uB358 \uCC30\uB098, \uC190\uBAA9\uC5D0\uC11C
      \uC9C4\uB3D9\uC774 \uC6B8\uB9B0\uB2E4."
    - "[Acord Co.] \uCE74\uB9B0 \uC5F0\uAD6C\uC6D0. \uB54C\uAC00 \uC654\uC2B5\uB2C8\uB2E4.
      \uADF8\uB4E4\uC758 \uBAA8\uB4E0 \uAC83\uC744 \uAC00\uC838\uC624\uC138\uC694."
    - "\uBD88\uAC00\uD53C\uD560 \uC2DC\uC5D0\uB294 \uADF8\uB4E4\uC758 \uC791\uD488\uC5D0
      \uBC14\uC774\uB7EC\uC2A4\uB97C \uC2EC\uC5B4\uC57C \uD569\uB2C8\uB2E4. \uB354
      \uC774\uC0C1 \uADF8\uB4E4\uC5D0\uAC8C \uAE30\uD68C\uB97C \uC8FC\uC5B4\uC120
      \uC548 \uB429\uB2C8\uB2E4."
    - "\uB2F9\uC2E0\uC744 \uC5C4\uD638\uD560 \uACBD\uD638 \uC778\uB825\uC744 \uBCF4\uB0B4\uACA0\uC2B5\uB2C8\uB2E4.
      \uBD80\uB514 \uC784\uBB34\uB97C \uC644\uBCBD\uD788 \uC644\uC218\uD574 \uC8FC\uC2DC\uAE38
      \uBC14\uB78D\uB2C8\uB2E4."
    - "[\uCE74\uB9B0] ...\uC774 \uC77C\uC744 \uC644\uC218\uD558\uC9C0 \uBABB\uD558\uBA74,
      \uC798\uB9AC\uACA0\uC9C0...?"
    - "[] \uCE74\uB9B0\uC740 \uC9D1\uC744 \uB098\uC11C\uC11C Mando Co.\uB85C \uD5A5\uD55C\uB2E4."
    autoNextTime: 0
  - image: {fileID: 8744364858846221468, guid: 82200a2eead21fa4282dfd4f7e04b156, type: 3}
    lines:
    - "[] Mando Co. \uC55E \uC8FC\uCC28\uC7A5. Acord\uC5D0\uC11C \uBCF4\uB0B8 \uACBD\uD638
      \uC778\uB825\uC774 \uAE30\uB2E4\uB9B0\uB2E4\uB294 \uAC80\uC740 \uC138\uB2E8\uC774
      \uBCF4\uC778\uB2E4.\r\n "
    - "[] \uCE74\uB9B0\uC740 \uCC28\uC5D0 \uC62C\uB77C\uD0C4\uB2E4. \uC6B4\uC804\uC11D\uC5D0
      \uC549\uC544 \uC788\uB358 \uACBD\uD638\uC6D0\uACFC \uB208\uC774 \uB9C8\uC8FC\uCE5C\uB2E4.\r\n "
    - "[\uCE74\uB9B0] \uCE74\uB860...? \uB0B4 \uACBD\uD638\uB97C \uB2F4\uB2F9\uD558\uB294
      \uAC8C \uCE74\uB860\uC774\uC57C?"
    - "[\uCE74\uB860] ...\uC5C5\uBB34 \uC911\uC5D0 \uC7A1\uB2F4\uC740 \uAE08\uC9C0\uC57C."
    - "[] \uCE74\uB860\uC774 \uB9D0\uC5C6\uC774 Mando Co. \uC0AC\uC6D0\uC99D\uC744
      \uAC74\uB128\uB2E4."
    - "[\uCE74\uB860] \uC774\uC81C\uBD80\uD130\uB294 \uC774 \uD68C\uC0AC\uC758 \uC0AC\uC6D0\uACFC
      \uCCAD\uC18C\uBD80\uC785\uB2C8\uB2E4. \uBC18\uB9D0\uC740 \uC0BC\uAC00\uD558\uC2ED\uC2DC\uC624."
    - "[] \uC190\uBAA9\uC758 \uC6CC\uCE58\uAC00 \uC9C4\uB3D9\uD558\uB354\uB2C8 Mando
      \uC0AC\uB0B4 \uC9C0\uB3C4\uAC00 \uC804\uC1A1\uB41C\uB2E4."
    - "[\uCE74\uB860] 1\uCE35 \uB85C\uBE44\uB294 \uAD6C\uD615 \uBCF4\uC548 \uB85C\uBD07\uB4E4\uC774
      \uC21C\uCC30 \uC911\uC785\uB2C8\uB2E4. \uC9C0\uB2A5\uC740 \uB0AE\uC9C0\uB9CC,
      \uC218\uC5D0 \uC555\uB3C4\uB2F9\uD558\uC9C0 \uB9C8\uC138\uC694."
    - "\uC0AC\uC804\uC5D0 \uC785\uC218\uD55C \uC815\uBCF4\uC5D0 \uB530\uB974\uBA74
      \uCE35\uBCC4\uB85C \uACBD\uBE44 \uB85C\uBD07\uC758 \uC218\uC900\uC774 \uC0C1\uC774\uD558\uB2E4\uACE0
      \uD569\uB2C8\uB2E4. \uC774 \uC810 \uC720\uC758\uD574 \uC8FC\uC2ED\uC2DC\uC624."
    - "\uC81C\uAC00 \uBA3C\uC800 \uB098\uAC00\uACA0\uC2B5\uB2C8\uB2E4. \uC7A0\uC2DC
      \uB4A4\uC5D0 \uB4A4\uCABD \uD654\uB2E8\uC744 \uD1B5\uD574 \uB3CC\uC544\uC11C
      \uC815\uBB38\uC73C\uB85C \uC624\uC2ED\uC2DC\uC624."
    - "...\uCD5C\uB300\uD55C \uC8FC\uC758\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
    - "[] \uCE74\uB860\uC774 \uBB38\uC744 \uC5F4\uACE0 \uCC28\uC5D0\uC11C \uB0B4\uB9B0\uB2E4."
    - "[\uCE74\uB9B0] ...\uCE74\uB860\uC774 \uB0B4 \uACBD\uD638\uB77C\uB2C8. \uC77C\uC774
      \uC810\uC810 \uCEE4\uC9C0\uB124."
    - "[] \uCE74\uB9B0\uC740 \uC228\uC744 \uACE0\uB974\uACE0, \uC7A0\uC2DC \uB4A4
      \uB530\uB77C \uB0B4\uB9B4 \uC900\uBE44\uB97C \uD55C\uB2E4."
    autoNextTime: 0
  cutImage: {fileID: 863912683}
